{
  "name": "echo-run",
  "version": "1.0.0",
  "description": "エコーラン: コインを取るたび時間が巻き戻るタイムループ・アクション",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync android",
    "android:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run sync && cd android && ./gradlew bundleRelease assembleRelease",
    "android:open": "cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aasergk-rgb/game.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/aasergk-rgb/game/issues"
  },
  "homepage": "https://github.com/aasergk-rgb/game#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  },
  "private": true
}
